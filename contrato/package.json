{
  "name": "contrato",
  "version": "0.1.0",
  "private": true,
  "description": "Contrato ERC-721 PolkaPets (Tamagotchi NFT) para Polkadot Hub.",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "node": "hardhat node",
    "deploy:local": "hardhat run scripts/deploy.ts --network localhost",
    "deploy:testnet": "hardhat run scripts/deploy.ts --network polkadotHubTestnet",
    "abi": "hardhat run scripts/exportAbi.ts",
    "balance": "hardhat run scripts/balance.ts --network polkadotHubTestnet",
    "probar": "hardhat run scripts/probar.ts --network polkadotHubTestnet"
  },
  "license": "MIT",
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@openzeppelin/contracts": "^5.1.0",
    "dotenv": "^16.4.5",
    "hardhat": "^2.22.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.6.3"
  }
}
